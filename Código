# ========== EJEMPLOS ADICIONALES AUTOMÁTICOS ==========
print("\n📋 EJEMPLOS DE REFERENCIA:")
print("-" * 50)
print("| Espera | Comodidad | Disponibilidad | Satisfacción |")
print("|--------|-----------|---------------|--------------|")

ejemplos = [
    (10, 8, 9),
    (30, 5, 6),
    (60, 3, 4),
    (90, 2, 3),
]

for e, c, d in ejemplos:
    tc = pertenencia_triangular(e, 0, 0, 40)
    tm = pertenencia_triangular(e, 20, 50, 80)
    tl = pertenencia_triangular(e, 60, 120, 120)
    
    cb = pertenencia_triangular(c, 0, 0, 5)
    cm = pertenencia_triangular(c, 2, 5, 8)
    ca = pertenencia_triangular(c, 6, 10, 10)
    
    di = pertenencia_triangular(d, 0, 0, 4)
    dr = pertenencia_triangular(d, 2, 5, 8)
    da = pertenencia_triangular(d, 6, 10, 10)
    
    rr1 = min(tl, cb)
    rr2 = min(tc, da)
    rr3 = min(tm, cm)
    rr4 = min(di, cb)
    rr5 = min(tc, ca)
    rr6 = min(tm, dr)
    
    ab = max(rr1, rr4)
    am = max(rr3, rr6)
    aa = max(rr2, rr5)
    
    num = (ab * 2.0) + (am * 5.0) + (aa * 8.0)
    den = ab + am + aa
    sat = round(num / den, 1) if den > 0 else 5.0
    
    print(f"| {e:6} | {c:9} | {d:13} | {sat:12} |")

