print(f"\n📌 ACTIVACIÓN DE REGLAS:")
print(f"   Regla 1 (Largo + Baja): {r1:.2f}")
print(f"   Regla 2 (Corto + Alta): {r2:.2f}")
print(f"   Regla 3 (Moderado + Media): {r3:.2f}")
print(f"   Regla 4 (Insuficiente + Baja): {r4:.2f}")
print(f"   Regla 5 (Corto + Alta comodidad): {r5:.2f}")
print(f"   Regla 6 (Moderado + Regular): {r6:.2f}")

print(f"\n🎯 SATISFACCIÓN ESTIMADA: {satisfaccion} / 10")
print(f"   Clasificación: {nivel}")
